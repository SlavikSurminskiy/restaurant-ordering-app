generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

/// Money fields (price, unitPrice, subtotal, discount, total) are integers in cents: 12550 = $125.50.
/// Hand-written CHECK constraints live in the separate migration `*_check_constraints` (Prisma can't model them).

enum Role {
  ADMIN
  CUSTOMER
}

enum OrderStatus {
  NEW
  PREPARING
  READY
  COMPLETED
  CANCELLED
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  name         String
  role         Role
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  orders Order[]

  @@map("users")
}

model Category {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  createdAt DateTime @default(now())

  dishes Dish[]

  @@map("categories")
}

model Dish {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  description String   @default("")
  photoUrl    String?
  /// Null only for open-price dishes: the customer enters the price.
  price       Int?
  isOpenPrice Boolean  @default(false)
  available   Boolean  @default(true)
  createdAt   DateTime @default(now())

  categoryId String   @db.Uuid
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  orderItems OrderItem[]

  @@index([categoryId])
  @@map("dishes")
}

model Order {
  id        String      @id @default(uuid()) @db.Uuid
  status    OrderStatus @default(NEW)
  subtotal  Int
  discount  Int
  total     Int
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  /// Generated by the client once per checkout and reused on retries, so a repeated request returns the same order.
  idempotencyKey String

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  items OrderItem[]

  @@unique([userId, idempotencyKey])
  @@map("orders")
}

/// Name and price are copied at order time, so later menu changes don't rewrite history.
model OrderItem {
  id        String @id @default(uuid()) @db.Uuid
  name      String
  unitPrice Int
  quantity  Int

  orderId String @db.Uuid
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  dishId String? @db.Uuid
  dish   Dish?   @relation(fields: [dishId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([dishId])
  @@map("order_items")
}
