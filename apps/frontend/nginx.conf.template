# Static files only: Traefik routes every /api path to its service before it gets here.
server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    # An unknown /api path gets 404, not the app's index.html (deploy/k8s/07-ingress.yaml and
    # docker-compose.prod.yml route the known ones).
    location /api/ {
        return 404;
    }

    # Built JS and CSS have content hashes in their names, so they never change.
    location ~* \.(?:js|css)$ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # index.html points to the current hashed files, so browsers must revalidate it.
    location = /index.html {
        add_header Cache-Control "no-cache";
    }

    # Client-side routes (/menu, /orders, …) fall back to the app.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
