{
  "name": "backend",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/backend/src",
  "projectType": "application",
  "tags": ["scope:backend", "type:app"],
  "targets": {
    "prepare-deploy": {
      "dependsOn": ["build"],
      "cache": true,
      "executor": "nx:run-commands",
      "inputs": [
        "production",
        "^production",
        "{workspaceRoot}/package.json",
        "{workspaceRoot}/pnpm-lock.yaml",
        "{workspaceRoot}/pnpm-workspace.yaml",
        {
          "runtime": "pnpm --version"
        }
      ],
      "outputs": [
        "{workspaceRoot}/dist/apps/backend/package.json",
        "{workspaceRoot}/dist/apps/backend/pnpm-lock.yaml"
      ],
      "options": {
        "parallel": false,
        "commands": [
          "node apps/backend/scripts/strip-workspace-deps.mjs",
          "pnpm install --lockfile-only --dir dist/apps/backend"
        ]
      }
    },
    "serve": {
      "continuous": true,
      "executor": "@nx/js:node",
      "defaultConfiguration": "development",
      "dependsOn": ["build", "database:prisma-seed"],
      "readyWhen": {
        "signal": true
      },
      "options": {
        "buildTarget": "backend:build",
        "runBuildTargetDependencies": false
      },
      "configurations": {
        "development": {
          "buildTarget": "backend:build:development"
        },
        "production": {
          "buildTarget": "backend:build:production"
        }
      }
    },
    "build": {
      "dependsOn": ["^build", "^prisma-generate"]
    },
    "test": {
      "dependsOn": ["^prisma-generate"]
    }
  }
}
