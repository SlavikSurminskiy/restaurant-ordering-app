# Template for .env.prod (git-ignored), read by docker-compose.prod.yml:
#   cp .env.prod.example .env.prod
# Replace every "change-me" value; never commit the real file.

POSTGRES_USER=restaurant
POSTGRES_PASSWORD=change-me
POSTGRES_DB=restaurant
# Host port for the seed and psql, bound to 127.0.0.1 (5432 is the development database)
POSTGRES_PORT=5433

# At least 32 characters, e.g. `openssl rand -base64 48`
JWT_SECRET=change-me
JWT_TTL=28800

ORDER_DISCOUNT=500
ORDER_STATUS_STEP_SECONDS=20

FRONTEND_PORT=8080
