# Template for the local .env file (git-ignored): pnpm env:init
# Values below are local development defaults only. Never commit real secrets;
# in deployed environments set these variables via the platform/CI instead.

# PostgreSQL in docker-compose
POSTGRES_USER=restaurant_user
POSTGRES_PASSWORD=restaurant_password
POSTGRES_DB=restaurant_db
POSTGRES_PORT=5432

DATABASE_URL=postgresql://restaurant_user:restaurant_password@localhost:5432/restaurant_db

# Backend
BACKEND_PORT=3000
