# Template for the local .env file (git-ignored): pnpm env:init
# Values below are local development defaults only. Never commit real secrets;
# in deployed environments set these variables via the platform/CI instead.

# PostgreSQL in docker-compose
POSTGRES_USER=restaurant_user
POSTGRES_PASSWORD=restaurant_password
POSTGRES_DB=restaurant_db
POSTGRES_PORT=5432

DATABASE_URL=postgresql://restaurant_user:restaurant_password@localhost:5432/restaurant_db

# Service ports (local development)
ORDERS_SERVICE_PORT=3000
AUTH_SERVICE_PORT=3001
MENU_SERVICE_PORT=3002
REALTIME_GATEWAY_PORT=3003

# Service-to-service base URLs: orders-service asks menu-service for prices while placing an order;
# orders-service and menu-service send events to the realtime gateway, which streams them to browsers.
MENU_SERVICE_URL=http://localhost:3002
EVENTS_URL=http://localhost:3003

# Fixed discount per order, in cents (500 = $5.00); read by menu-service
ORDER_DISCOUNT=500

# Seconds an order stays in each status before orders-service moves it on
# (NEW -> PREPARING -> READY -> COMPLETED)
ORDER_STATUS_STEP_SECONDS=20

# Auth: JWT signing secret (local development only) and token/cookie lifetime
# in seconds (28800 = 8 h)
JWT_SECRET=local-dev-jwt-secret-change-me
JWT_TTL=28800
